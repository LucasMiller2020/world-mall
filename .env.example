# World Mall - Environment Variables
# Copy to .env and fill values before running.

# World ID Configuration (Required)
# Get your App ID from https://developer.worldcoin.org
WORLD_ID_APP_ID=your_app_id_here
WORLD_ID_ACTION=world-mall/verify
# Cloud secret is optional - only needed for some configurations
WORLD_ID_CLOUD_SECRET=your_cloud_secret_here

# Database Configuration (Required)
# PostgreSQL connection string
DATABASE_URL=postgresql://user:pass@host:5432/worldmall

# Session Configuration (Required)
# Generate a secure random string for session encryption
SESSION_SECRET=your_session_secret_here

# Feature Flags
# Enable/disable Permit2 integration (default: false)
ENABLE_PERMIT2=false

# Optional policy overrides for guests/verified
# GUEST_CHAR_LIMIT=60
# GUEST_DAILY=10
# GUEST_COOLDOWN_SEC=30
# VERIFIED_RATE_PER_MIN=5
# VERIFIED_RATE_PER_HR=60
# VERIFIED_RATE_PER_DAY=200
