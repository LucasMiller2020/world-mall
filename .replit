modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["jq"]

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5904
externalPort = 80

[[ports]]
localPort = 36149
externalPort = 4200

[[ports]]
localPort = 36433
externalPort = 3003

[[ports]]
localPort = 37157
externalPort = 6000

[[ports]]
localPort = 37221
externalPort = 8080

[[ports]]
localPort = 40015
externalPort = 3002

[[ports]]
localPort = 40789
externalPort = 8000

[[ports]]
localPort = 41083
externalPort = 6800

[[ports]]
localPort = 42135
externalPort = 3001

[[ports]]
localPort = 43551
externalPort = 8008

[[ports]]
localPort = 45547
externalPort = 3000

[[ports]]
localPort = 45669
externalPort = 5173

[env]
PORT = "5000"

[agent]
integrations = ["javascript_mem_db:1.0.0", "javascript_websocket:1.0.0", "javascript_database:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000
